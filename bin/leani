#!/usr/bin/env python3
"""PATH から叩くための入口。

中身は src/leani.py にある。実行時の依存が無いので venv は要らず、
その辺の python3 でそのまま動く。開発中は `uv run leani` でもいい。
"""
import os
import sys

sys.path.insert(0, os.path.join(
    os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "src"))

from leani import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
